# ============================================================================
# SECRETS & PER-ENVIRONMENT CONFIG — never commit these.
# Templates ending in `.example` ARE committed to document the structure.
# ============================================================================

# Firebase native config files (one pair per app variant, see README §3).
**/google-services.json
**/GoogleService-Info.plist

# Scratch files for handing tokens to tooling
.mapbox-secret

# Firebase Admin service-account keys
**/service-account*.json

# Environment files
.env
.env.*
!.env.example

# Signing material
*.keystore
*.jks
*.p8
*.p12
*.mobileprovision
*.pem

# Firebase CLI local state
.firebase/
firebase-debug.log
