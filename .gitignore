# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ============================================================================
# SECRETS & PER-ENVIRONMENT CONFIG — never commit these.
# Templates ending in `.example` ARE committed to document the structure.
# ============================================================================

# Firebase config files (generated by `flutterfire configure`).
**/google-services.json
**/GoogleService-Info.plist
lib/firebase_options.dart
lib/firebase_options_*.dart
# ...but keep the committed templates:
!**/google-services.json.example
!**/GoogleService-Info.plist.example

# Environment / dart-define files (contain Mapbox token etc.)
config/dart_define.json
config/dart_define.*.json
!config/dart_define.example.json
.env
.env.*
!.env.example

# Android signing / keystores
**/*.keystore
**/*.jks
android/key.properties

# iOS signing
ios/Runner/GoogleService-Info.plist
ios/**/*.mobileprovision
ios/**/*.p12
ios/**/*.cer

# Functions
functions/node_modules/
functions/lib/

# FlutterFire / Firebase CLI local state
.firebase/
firebase-debug.log
