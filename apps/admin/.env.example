# Admin app environment template. Copy to `.env` (git-ignored) and adjust.
# VITE_* values are inlined into the bundle, so only public values go here.

# The API (`pnpm --filter @depanini/api start:dev`). It must list this app's origin
# in CORS_ORIGINS (dev server: http://localhost:5173).
VITE_API_URL=http://localhost:3000

# Firebase web config. Dev uses the Auth emulator with the demo project id.
VITE_FIREBASE_PROJECT_ID=depanini-dev
VITE_FIREBASE_API_KEY=demo-api-key
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_APP_ID=

# Firebase Auth emulator (`pnpm emulators` at the repo root). Remove to use the real project.
VITE_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# Privacy policy and Terms pages in the footer (docs/legal, see CI.md). Defaults to GitHub Pages.
# VITE_PRIVACY_URL=https://ayoubachour94.github.io/depanini-app/legal/privacy-en/
# VITE_TERMS_URL=https://ayoubachour94.github.io/depanini-app/legal/terms-en/

# Error reporting (Sentry), a project DSN (public by design). Unset = off: nothing is initialised
# or sent. Optional environment tag, default is the Vite mode ("development" / "production").
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=
