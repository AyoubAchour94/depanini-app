# API environment template. Copy to `.env` (git-ignored) and adjust.
# Validated at boot by src/config/env.ts.

NODE_ENV=development
PORT=3000
# Matches docker-compose.yml at the repo root (`pnpm db:up`).
DATABASE_URL=postgres://depanini:depanini@localhost:5432/depanini
# Pool size and how long a request waits for a free connection before a 503.
# DB_POOL_MAX=10
# DB_CONNECTION_TIMEOUT_MS=5000
FIREBASE_PROJECT_ID=depanini-dev
# Browser origins allowed to call the API: the Expo web dev server (`pnpm web:user`) and the admin app (`pnpm --filter @depanini/admin dev`).
CORS_ORIGINS=http://localhost:8081,http://localhost:5173

# Firebase Auth emulator (`pnpm emulators` at the repo root). When set,
# firebase-admin accepts the emulator's unsigned ID tokens. Never set in production.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Hardening (defaults shown; see README §5). Proxies in front of the API: 1 on Cloud
# Run, 0 when clients connect directly.
# TRUST_PROXY_HOPS=1
# Rate limits per signed-in user (or per IP signed out), per window; writes have their own.
# THROTTLE_TTL_MS=60000
# THROTTLE_LIMIT=300
# THROTTLE_WRITE_LIMIT=60
# Document uploads per driver, counted in Postgres.
# UPLOAD_LIMIT_PER_HOUR=20
# UPLOAD_LIMIT_PER_DAY=60
# A handler still running after this answers 503 (uploads are exempt).
# REQUEST_TIMEOUT_MS=30000
# fatal | error | warn | info | debug | trace | silent. JSON logs, pretty in development.
# LOG_LEVEL=info

# Push notifications (docs/push.md). `log` only logs; `fcm` needs a service account.
# PUSH_PROVIDER=log
# Exposes GET /dev/push-inbox for the e2e flow; ignored in production.
# PUSH_INBOX=1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON=
