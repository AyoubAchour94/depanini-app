# API environment template. Copy to `.env` (git-ignored) and adjust.
# Validated at boot by src/config/env.ts.

NODE_ENV=development
PORT=3000
# Matches docker-compose.yml at the repo root (`pnpm db:up`).
DATABASE_URL=postgres://depanini:depanini@localhost:5432/depanini
FIREBASE_PROJECT_ID=depanini-dev
# Browser origins allowed to call the API: the Expo web dev server (`pnpm web:user`).
CORS_ORIGINS=http://localhost:8081

# Firebase Auth emulator (`pnpm emulators` at the repo root). When set,
# firebase-admin accepts the emulator's unsigned ID tokens. Never set in production.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Push notifications (docs/push.md). `log` only logs; `fcm` needs a service account.
# PUSH_PROVIDER=log
# Exposes GET /dev/push-inbox for the e2e flow; ignored in production.
# PUSH_INBOX=1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON=
