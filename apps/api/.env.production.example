# Production environment for the API. NOT a file to deploy: these are the
# variables to set on the Cloud Run service (secrets through Secret Manager).
# Validated at boot by src/config/env.ts; a bad value stops the container.
# Full runbook: CI.md ("API deploy").

# Set by the Dockerfile. Production refuses FIREBASE_AUTH_EMULATOR_HOST.
NODE_ENV=production

# Injected by Cloud Run (8080). Do not set.
# PORT=8080

# SECRET. Postgres with PostGIS, with TLS, e.g. Neon:
# postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
# The same value is the GitHub secret DATABASE_URL, used by the migration step.
DATABASE_URL=

# Most connections the API opens per instance, and how long a request waits for
# one before a 503. Keep (instances x DB_POOL_MAX) under the database's limit
# (small free plans allow few connections; use the provider's pooled host).
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000

# The production Firebase project whose ID tokens are accepted (e.g. depanini-prod).
FIREBASE_PROJECT_ID=

# Browser origins allowed to call the API (CORS): the admin app's URL. Native
# apps do not need CORS. Leave empty if there is no browser client.
CORS_ORIGINS=

# Error reporting (README §5). Not a secret, but project-specific. Unset = no reports.
# SENTRY_DSN=
# Tag on events; defaults to NODE_ENV ("production"). Set "staging" on a staging service.
# SENTRY_ENVIRONMENT=

# `log` only writes pushes to the log; `fcm` sends them (docs/push.md).
PUSH_PROVIDER=log
# With `fcm`, one of these is required. SECRET. On Cloud Run prefer the JSON in
# Secret Manager.
# GOOGLE_APPLICATION_CREDENTIALS=
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Never set in production: FIREBASE_AUTH_EMULATOR_HOST (boot fails), PUSH_INBOX (ignored).

# Hardening (defaults shown; all optional). Rate limits are per user, or per IP
# when signed out, counted in memory per instance.
# Proxies in front of the API that append to X-Forwarded-For. Cloud Run alone: 1.
# Behind a Google HTTPS load balancer in front of Cloud Run: 2. Too low and every
# signed-out caller shares one IP bucket; too high and clients can spoof their IP.
TRUST_PROXY_HOPS=1
# Rate-limit window, and requests per window (all methods / writes only).
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300
THROTTLE_WRITE_LIMIT=60
# Document uploads per driver per rolling hour / day, counted in Postgres
# (the append-only document_uploads log), so it holds across instances.
UPLOAD_LIMIT_PER_HOUR=20
UPLOAD_LIMIT_PER_DAY=60
# A handler still running after this long answers 503. Uploads are exempt.
REQUEST_TIMEOUT_MS=30000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
