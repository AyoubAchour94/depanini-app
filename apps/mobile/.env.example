# Mobile environment template. Copy to `.env` (git-ignored) and fill in.
# EXPO_PUBLIC_* values are inlined into the app bundle: never put secrets here.
# In EAS builds these come from EAS environment variables instead (see CI.md).

# Mapbox PUBLIC token (pk....).
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.REPLACE_WITH_YOUR_MAPBOX_PUBLIC_TOKEN

# Base URL of the API (apps/api). From the Android emulator, the host machine is
# 10.0.2.2; from a physical device, use your computer's LAN IP.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
# Used instead of the above when running in a browser (`pnpm web:user`).
EXPO_PUBLIC_WEB_API_URL=http://localhost:3000

# dev | staging | prod
EXPO_PUBLIC_ENVIRONMENT=dev

# Firebase web app config as JSON (public values), only used by the web build.
# Get it with: firebase apps:sdkconfig WEB 1:849858510710:web:14cb25941f94012a568457
EXPO_PUBLIC_FIREBASE_WEB_CONFIG='{"apiKey":"...","authDomain":"depanini-dev.firebaseapp.com","projectId":"depanini-dev","storageBucket":"...","messagingSenderId":"...","appId":"..."}'

# Firebase Auth emulator (`pnpm emulators` at the repo root). When set, sign-in
# goes to the emulator instead of the real project. Leave unset otherwise.
# EXPO_PUBLIC_AUTH_EMULATOR_URL=http://10.0.2.2:9099
# EXPO_PUBLIC_WEB_AUTH_EMULATOR_URL=http://localhost:9099

# Driver app: lets you set the driver's location on a map (for testing outside
# Tunisia). Always on in development builds; set to 1 to enable it in a test build.
EXPO_PUBLIC_ENABLE_TEST_LOCATION=0
