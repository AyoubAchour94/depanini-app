// iOS flavor config: DRIVER app ("Depanini Driver")
//
// #included by the *-driver Xcode build configurations. See the README
// "iOS flavors" section and flavor-user.xcconfig for the full wiring steps.
// Create a scheme named exactly "driver" so `--flavor driver` resolves to it.

#include "Generated.xcconfig"

// Unique bundle identifier for the driver app (must match Firebase + App Store Connect).
PRODUCT_BUNDLE_IDENTIFIER = com.depanini.driver

// Display name shown under the app icon. Referenced by Info.plist via $(APP_DISPLAY_NAME).
APP_DISPLAY_NAME = Depanini Driver
