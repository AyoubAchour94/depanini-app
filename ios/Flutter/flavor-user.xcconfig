// iOS flavor config: USER app ("Depanini")
//
// This file is #included by the per-flavor Xcode build configurations you
// create in Xcode (see README "iOS flavors" section). It sets the values that
// make the user app distinct from the driver app.
//
// Wiring (done once, in Xcode on a Mac):
//   1. Duplicate the Debug/Profile/Release configurations into:
//        Debug-user, Profile-user, Release-user
//        Debug-driver, Profile-driver, Release-driver
//   2. For each *-user config, set its xcconfig to include this file.
//   3. Create a scheme named exactly "user" that uses the *-user configs.
//      (Flutter maps `--flavor user` to the scheme named "user".)

#include "Generated.xcconfig"

// Unique bundle identifier for the user app (must match Firebase + App Store Connect).
PRODUCT_BUNDLE_IDENTIFIER = com.depanini.app

// Display name shown under the app icon. Referenced by Info.plist via $(APP_DISPLAY_NAME).
APP_DISPLAY_NAME = Depanini
