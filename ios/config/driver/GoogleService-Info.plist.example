<?xml version="1.0" encoding="UTF-8"?>
<!--
  TEMPLATE ONLY for the DRIVER iOS app (bundle id com.depanini.driver).

  The REAL GoogleService-Info.plist is generated by `flutterfire configure`
  (or downloaded from the Firebase console for the iOS app whose bundle id is
  com.depanini.driver). Save the real file next to this one as:
      ios/config/driver/GoogleService-Info.plist     (git-ignored)

  A Run Script build phase copies the correct flavor file into the build at
  compile time — see the README "iOS flavors → Firebase per flavor" section.
-->
<plist version="1.0">
<dict>
	<key>BUNDLE_ID</key>
	<string>com.depanini.driver</string>
	<key>PROJECT_ID</key>
	<string>REPLACE_WITH_FIREBASE_PROJECT_ID</string>
	<key>API_KEY</key>
	<string>REPLACE_WITH_IOS_API_KEY</string>
	<key>GCM_SENDER_ID</key>
	<string>REPLACE_WITH_SENDER_ID</string>
	<key>GOOGLE_APP_ID</key>
	<string>REPLACE_WITH_IOS_APP_ID</string>
	<key>STORAGE_BUCKET</key>
	<string>REPLACE_WITH_PROJECT_ID.appspot.com</string>
	<key>IS_GCM_ENABLED</key>
	<true/>
	<key>PLIST_VERSION</key>
	<string>1</string>
</dict>
</plist>
